# ChargeRoute AI Environment Configuration

# Environment mode ('development' or 'production')
ENVIRONMENT=development
DEBUG=true

# Database (defaults to async SQLite for local development, or PostgreSQL in Docker)
DATABASE_URL=sqlite+aiosqlite:///./voltplan.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://voltplan:voltplan_secure_password_2026@localhost:5432/voltplan

# Secret key for JWT session generation
SECRET_KEY=chargeroute-super-secret-key-change-in-production-2026-gujarat
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Routing & Maps Provider Adapters
OSRM_ROUTING_URL=https://router.project-osrm.org

# Optional Third-Party Map & Charging APIs
# Set GOOGLE_MAPS_API_KEY to enable Google Maps Geocoding and Places API for rural villages across Gujarat
GOOGLE_MAPS_API_KEY=
OPEN_CHARGE_MAP_API_KEY=

# Frontend Configuration (uses relative /api/v1 for cross-device compatibility with Next.js rewrites)
NEXT_PUBLIC_API_URL=/api/v1

# Firebase Authentication Configuration
# Fill in your Firebase web app keys from Firebase Console (https://console.firebase.google.com -> Project Settings -> General -> Your apps -> SDK setup/configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
